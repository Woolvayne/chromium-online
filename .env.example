# ============================================================================
# WebPilot AI — Umgebungsvariablen
# Diese Datei nach ".env" kopieren und Werte anpassen.
# ============================================================================

# --- Datenbank (PostgreSQL) -------------------------------------------------
# Lokal:            postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Docker-Compose:   postgresql://postgres:postgres@db:5432/app_db
# Supabase:         postgresql://postgres:<passwort>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Verschlüsselung der gespeicherten API-Keys (PFLICHT) -------------------
# Zufälligen Schlüssel erzeugen:  openssl rand -hex 32
ENCRYPTION_KEY=

# --- Optionaler Server-Fallback-Provider ------------------------------------
# Wird genutzt, wenn kein Anbieter in den Einstellungen hinterlegt ist.
# Mögliche Werte für DEFAULT_AI_PROVIDER: mistral | openai | qwen | compatible
# DEFAULT_AI_PROVIDER=mistral
# DEFAULT_AI_API_KEY=
# DEFAULT_AI_BASE_URL=
# DEFAULT_AI_MODEL=mistral-small-latest

# --- Browser-Engine ----------------------------------------------------------
# "false" zeigt das Chromium-Fenster an (nur für Desktop-Debugging sinnvoll)
# BROWSER_HEADLESS=true
# Minuten, nach denen inaktive Browser-Sessions automatisch geschlossen werden
# BROWSER_IDLE_TIMEOUT_MIN=30
